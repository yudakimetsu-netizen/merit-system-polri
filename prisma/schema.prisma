generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  email    String?
  role     String   // ADMIN, OPERATOR
  satkerId Int?
  satker   Satker?  @relation(fields: [satkerId], references: [id])
}

model Satker {
  id       Int              @id @default(autoincrement())
  kode     String           @unique
  nama     String
  users    User[]
  personel Personel[]
  riwayat  RiwayatJabatan[]
}

model Personel {
  id                Int              @id @default(autoincrement())
  nama              String
  nrp               String           @unique
  nik               String?
  pangkat           String
  jenisKelamin      String?          // Laki-laki, Perempuan
  jenisPersonel     String?          // POLRI, ASN
  tempatLahir       String
  tanggalLahir      DateTime
  email             String?
  tingkatPendidikan String?          // SD, SMP, SMA, D3, D4/S1, S2, S3
  statusPersonel    String           @default("AKTIF") // AKTIF, PENSIUN, NONAKTIF
  pernahDiklat      String?          // PENDIDIKAN, DIKLAT, SEMUA
  satkerId          Int
  satker            Satker           @relation(fields: [satkerId], references: [id])
  riwayat           RiwayatJabatan[]
  pendidikan        Pendidikan[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model RiwayatJabatan {
  id              Int       @id @default(autoincrement())
  personelId      Int
  personel        Personel  @relation(fields: [personelId], references: [id], onDelete: Cascade)
  jabatan         String
  satkerId        Int
  satker          Satker    @relation(fields: [satkerId], references: [id])
  fungsi          String
  tanggalMulai    DateTime
  tanggalBerakhir DateTime?
  nivelering      Int
  statusJabatan   String    // AKTIF, NONAKTIF
  keterangan      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Pendidikan {
  id             Int      @id @default(autoincrement())
  personelId     Int
  personel       Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)
  jenis          String   // PENDIDIKAN, DIKLAT
  nama           String   // S1 Teknik Informatika, Sespimti, dll
  institusi      String?
  tahunLulus     Int?
  keterangan     String?
  createdAt      DateTime @default(now())
}